# ── App ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
DATABASE_URL=postgres://shiplog:shiplog@localhost:5432/shiplog
# Optional: enables the database tests (bun run test). Created by hand: CREATE DATABASE shiplog_test
TEST_DATABASE_URL=postgres://shiplog:shiplog@localhost:5432/shiplog_test
BETTER_AUTH_SECRET=change-me-32+chars

# ── Slack (one app: OIDC sign-in + bot + interactivity) ─────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=                  # restrict sign-in to this workspace
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
SLACK_FEED_CHANNEL_ID=          # existing channel, now a read-only feed
# Development only: comma-separated Slack user IDs that may receive DMs; DMs to anyone else go to
# the first ID instead, marked with who they were for. Leave empty in production.
SLACK_DM_ALLOWLIST=

# ── GitLab (gitlab.com, Premium) ────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.com
GITLAB_GROUP_PATH=your-group    # top-level group
# Optional: project whose members may connect GitLab when GITLAB_API_TOKEN is a project token
# (it can't list group members). Unset in production, where the group token is used.
GITLAB_MEMBERSHIP_PROJECT=
GITLAB_WEBHOOK_SECRET=          # matches X-Gitlab-Token on the group webhook
GITLAB_API_TOKEN=               # group access token, read_api only
GITLAB_OAUTH_CLIENT_ID=         # OAuth app, read_user scope ("Connect GitLab")
GITLAB_OAUTH_CLIENT_SECRET=

# ── Labels ──────────────────────────────────────────────────────────
LABEL_DONE="Development: Done"
LABEL_BRANCH_PREFIX="Branch: "
LABEL_WEIGHT_PREFIX="Weight: "

# ── Work item statuses (D44) ────────────────────────────────────────
STATUS_TRIGGERS="Done,Deployed Main,Deployed Staging"   # also ship on these
STATUS_DEPLOYED_PREFIX="Deployed "                       # "Deployed Main" → branch Main

# ── Timing ──────────────────────────────────────────────────────────
REMINDER_AFTER_HOURS=4
AUTO_PUBLISH_AFTER_HOURS=24
BRANCH_CHOICES="Main,Staging"   # buttons in the "which branch?" DM

# ── LLM: notes drafts (D50); any OpenAI-compatible endpoint ─────────
LLM_ENABLED=false
LLM_PROVIDER_NAME=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
